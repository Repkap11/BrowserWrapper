{
  "manifest_version": 2,
  "name": "H Scroll Blocker",
  "version": "1.0",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "h_scroll_blocker.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "h_scroll_blocker@repkap11.com"
    }
  }
}